{
  "project_name": "FalkorDB Graph Agent Console",
  "theme": "Dark SOC Obsidian Tactical",
  "archetype": "THE PERFORMANCE PRO / CYBER INTELLIGENCE",
  "colors": {
    "background_base": "#0A0D14",
    "surface_panel": "#111722",
    "surface_panel_border": "#1F293D",
    "surface_card": "#161F2E",
    "text_primary": "#F3F4F6",
    "text_secondary": "#9CA3AF",
    "text_muted": "#6B7280",
    "accent_primary": "#06B6D4",
    "accent_primary_glow": "rgba(6, 182, 212, 0.25)",
    "accent_success": "#10B981",
    "accent_warning": "#F59E0B",
    "accent_critical": "#EF4444",
    "accent_agent_node": "#8B5CF6",
    "graph_canvas_bg": "#07090E",
    "graph_node_default": "#38BDF8",
    "graph_node_visited": "#A855F7",
    "graph_edge_default": "#334155",
    "graph_edge_active": "#06B6D4"
  },
  "typography": {
    "headings_font": "JetBrains Mono, Fira Code, monospace",
    "body_font": "IBM Plex Sans, Inter, sans-serif",
    "mono_font": "JetBrains Mono, monospace",
    "scale": {
      "h1": "text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight",
      "h2": "text-xl sm:text-2xl font-semibold tracking-tight",
      "h3": "text-lg font-medium",
      "body": "text-sm sm:text-base leading-relaxed",
      "small_label": "text-xs font-mono uppercase tracking-widest text-slate-400"
    }
  },
  "layout_and_grids": {
    "container_padding": "p-4 sm:p-6 lg:p-8",
    "gap_scale": "gap-4 sm:gap-6",
    "dashboard_mode": "High Density Grid with Command Panel on Left/Top and Cytoscape Canvas as Hero Center",
    "card_borders": "1px solid #1F293D",
    "corner_radius": "rounded-lg"
  },
  "visual_enhancers": {
    "glassmorphism": "backdrop-blur-xl bg-slate-900/80 border border-slate-800/80",
    "tracing_beam": "glow-border-cyan subtle 1px animated highlight",
    "card_hover": "hover:border-cyan-500/50 hover:shadow-[0_0_15px_rgba(6,182,212,0.15)] transition-all duration-200"
  },
  "components_and_structure": {
    "navigation_header": {
      "component": "TopNavbar",
      "location": "/app/frontend/src/components/TopNavbar.js",
      "features": [
        "System Status Indicator",
        "Session ID Badge",
        "Dark Theme Toggle",
        "API Endpoint Health status"
      ]
    },
    "command_panel": {
      "component": "CommandPanel",
      "location": "/app/frontend/src/pages/Orchestrator.js",
      "features": [
        "Prompt Input Area",
        "Preset Prompts",
        "Session ID Input",
        "Investigate Action Button with Loading State"
      ]
    },
    "graph_canvas": {
      "component": "GraphCanvas",
      "location": "/app/frontend/src/components/GraphCanvas.js",
      "features": [
        "Cytoscape.js canvas",
        "Interactive Nodes and Edges",
        "Node Click Details Drawer trigger",
        "Zoom/Fit Controls",
        "Visited Nodes Glow"
      ]
    },
    "agent_trace_panel": {
      "component": "AgentLogStream",
      "location": "/app/frontend/src/components/AgentLogStream.js",
      "features": [
        "Realtime/Sequential Step Trace",
        "Step status badges (Executing, Success, Failed)",
        "Visited Cypher query previews"
      ]
    },
    "answer_card": {
      "component": "AnswerCard",
      "location": "/app/frontend/src/components/AnswerCard.js",
      "features": [
        "Final synthesized reasoning output",
        "Execution metrics (latency, nodes traversed)",
        "Copy answer functionality"
      ]
    },
    "node_details_drawer": {
      "component": "NodeDetailsDrawer",
      "location": "/app/frontend/src/components/NodeDetailsDrawer.js",
      "features": [
        "Side drawer for selected Cytoscape node properties",
        "JSON tree viewer or property key-value table"
      ]
    }
  },
  "image_urls": {
    "network_graph_bg": "https://images.unsplash.com/photo-1644088379091-d574269d422f?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NjA0MTJ8MHwxfHNlYXJjaHwxfHxjeWJlciUyMHNlY3VyaXR5JTIwbmV0d29yayUyMGdyYXBoJTIwbm9kZXMlMjBkYXJrJTIwbW9kZXxlbnwwfHx8fDE3OTIyOTM1NDF8MA&ixlib=rb-4.1.0&q=85",
    "cyber_tactical_keypad": "https://images.pexels.com/photos/37709121/pexels-photo-37709121.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940",
    "soc_analyst_avatar": "https://images.pexels.com/photos/5380594/pexels-photo-5380594.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940"
  },
  "testing_attributes": {
    "rule": "All interactive elements, input fields, navigation controls, graph elements, and text displays MUST have explicit data-testid attributes.",
    "examples": [
      "data-testid=\"investigate-prompt-input\"",
      "data-testid=\"investigate-submit-button\"",
      "data-testid=\"session-id-input\"",
      "data-testid=\"graph-canvas-container\"",
      "data-testid=\"agent-trace-step\"",
      "data-testid=\"answer-card-content\"",
      "data-testid=\"node-details-drawer\""
    ]
  },
  "instructions_to_main_agent": [
    "Ensure Javascript / React components follow clean modular patterns without JSX typing errors.",
    "Support both full JSON response render and modular trace streaming structures.",
    "Maintain high-contrast APCA accessibility for dark theme background and cyan accents.",
    "Ensure Cytoscape canvas resizes cleanly with window resize events.",
    "Always apply data-testid to every interactive component and metric display."
  ],
  "UNIVERSAL GUIDELINES FOR MAIN AGENT": [
    "Avoid generic AI slop centered layouts; build dense, tactical command workstation panels.",
    "Layer cards with crisp 1px borders and subtle cyan/purple glows.",
    "Never use generic AI emojis like 🤖 or 🧠; use Lucide-react or Radix icons.",
    "Every button and input must have smooth micro-interactions (hover, focus ring, active scale).",
    "Keep code modular and ensure backend FastAPI endpoints align with backend/server.py."
  ]
}
